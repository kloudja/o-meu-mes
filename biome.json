{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.mjs",
      "scripts/check-boundaries.mjs",
      "scripts/hosted*.mjs",
      "scripts/healthcheck.mjs",
      "tests/integration/hosted.test.ts",
      "tests/deployment/**",
      "tests/**/mu0-*",
      "tests/**/mu1-*",
      "tests/**/mu2-*",
      "tests/**/mu3-*",
      "tests/**/mu5-*",
      "tests/**/mu6-*",
      "tests/**/mu4-*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 110,
    "includes": [
      "src/shared/**",
      "src/config/**",
      "src/modules/finance/contracts/**",
      "src/modules/finance/i18n/**",
      "src/modules/finance/ui/MonthOverview.tsx",
      "src/modules/finance/ui/WorkspaceNavigation.tsx",
      "src/modules/finance/ui/FinanceApp.tsx",
      "src/modules/finance/ui/MovementHistory.tsx",
      "src/modules/finance/ui/PaymentFeedback.tsx",
      "src/modules/finance/ui/amount-display.ts",
      "scripts/check-boundaries.mjs",
      "scripts/hosted*.mjs",
      "scripts/healthcheck.mjs",
      "src/server/hosted*.mjs",
      "src/server/background-jobs.mjs",
      "tests/integration/hosted.test.ts",
      "tests/deployment/**",
      "tests/**/mu0-*",
      "tests/**/mu1-*",
      "tests/**/mu3-*",
      "tests/**/mu5-*",
      "tests/**/mu6-*",
      "tests/**/mu4-*",
      "src/modules/identity/**",
      "src/modules/privacy/**",
      "src/server/recovery-registry.mjs",
      "src/modules/spaces/**",
      "src/modules/finance/client/**",
      "src/modules/finance/infrastructure/**",
      "src/app/Application.tsx",
      "src/app/api/{spaces,requests,history,state,sharing,closure,export,privacy}/**",
      "src/app/privacidade/**",
      "src/server/assign-legacy.mjs",
      "src/server/http.ts",
      "src/app/api/identity/**",
      "src/server/transition.mjs",
      "src/server/unavailable-finance.ts",
      "src/proxy.ts"
    ]
  },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": { "noUnusedImports": "error", "noUnreachable": "error", "noConstAssign": "error" },
      "suspicious": {
        "noDuplicateCase": "error",
        "noExplicitAny": "error",
        "noFallthroughSwitchClause": "error"
      }
    }
  }
}
