# Install as /etc/omeumes/app.env (root:root, 0600), never in Git.
OMEUMES_DATA_ROOT=/state
OMEUMES_DB_PATH=/state/database/o-meu-mes.sqlite
OMEUMES_RECOVERY_REGISTRY=/state/authority/recovery.sqlite
OMEUMES_AUTH_ORIGIN=https://omeumes.pt
OMEUMES_MAIL_TRANSPORT=brevo
OMEUMES_AUTH_KEY=GENERATE_ON_VPS
OMEUMES_RECOVERY_KEY=GENERATE_SEPARATELY_ON_VPS
BREVO_API_KEY=ENTER_PRIVATELY_ON_VPS
BREVO_SENDER=ENTER_VERIFIED_SENDER_ON_VPS
# Set after creating the operator's account, using its stable user ID.
# OMEUMES_RIGHTS_HANDLER=
